# Vercel + Supabase 환경변수 목록. 실제 값은 저장소에 쓰지 않습니다.
# 기존 .env.local을 덮어쓰지 마세요. Vercel Preview/Production에 각각 등록하세요.
# 현재 운영 절차: docs/operations/managed-cloud-release.md
# 자체 운영은 ops/self-hosted/app.env.example 사용. 두 모드의 기준값을 섞지 않습니다.
SUPABASE_DEPLOYMENT_KIND=cloud
AUTH_PROFILE=managed-cloud-v1
PREVIEW_REVIEW_ONLY=false
# SMTP 및 승인 개인정보 문안을 준비한 뒤 별도 검증 후 true로 변경합니다.
AUTH_EMAIL_ENABLED=false
# Open public signup only after the institution authorizes it. Invitations are independent.
AUTH_SIGNUP_ENABLED=false

# 브라우저 공개: RLS/권한 검증이 필요합니다. Preview는 별도 Supabase 프로젝트를 사용합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용: 현재 인증 요청 제한 RPC에서 필요합니다. NEXT_PUBLIC_ 접두사 금지.
SUPABASE_SERVICE_ROLE_KEY=
# 독립적인 암호학적 난수 32자 이상. DB/API 키를 재사용하지 않습니다.
AUTH_RATE_LIMIT_SECRET=

# 이 환경의 고정 HTTPS origin (경로와 끝 / 없음). 두 값이 같아야 합니다.
AUTH_SITE_ORIGIN=
CERTIFICATE_VERIFY_ORIGIN=

# 현재는 Supabase native 한도 + 홈페이지 HMAC 요청 제한을 사용합니다.
AUTH_ABUSE_MODE=native-rate-limits
AUTH_CAPTCHA_ENABLED=false
# CAPTCHA 도입 시 실제 site key와 대응하는 Supabase Auth secret을 등록합니다.
AUTH_TURNSTILE_SITE_KEY=
AUTH_TRUSTED_IP_HEADER=x-vercel-forwarded-for
# AUTH_LOCAL_CAPTCHA_TEST는 운영/Preview에 등록하지 않습니다.
# legacy TRUST_PROXY_IP는 미설정 또는 false. 실제 프록시 경계는 별도 검증합니다.

# 배포 검사 전용·서버 전용 기준값. Preview/Production 모두 동일한 운영 기준을 등록합니다.
# Production은 일치, Preview는 사이트와 DB 모두 불일치해야 합니다.
RELEASE_PRODUCTION_SITE_ORIGIN=
RELEASE_PRODUCTION_SUPABASE_REF=
# VERCEL / VERCEL_ENV는 Vercel 시스템 변수를 사용합니다. 임의로 등록하지 않습니다.
# CAPTCHA secret / SMTP 암호 / 관리자 토큰은 이 앱의 공개 환경변수가 아닙니다.
