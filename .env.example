# ==============================================================================
# 울산과학대학교 앵커사업단 평생직업교육 플랫폼 - 환경 변수 안내 예시 파일 (.env.example)
# ==============================================================================
# [안내 사항]
# 1. 이 파일은 프로젝트에 필요한 환경 변수의 목록과 설명을 보여주는 예시(Template) 파일입니다.
# 2. 실제 비밀 키(Secret Key)나 주소는 이 파일에 직접 입력하지 마세요!
# 3. 로컬에서 작업할 때는 이 파일을 복사하여 `.env.local` 파일로 만든 뒤 실제 값을 입력해야 합니다.
# 4. `.env.local` 파일은 깃허브(Git)에 절대 올라가지 않도록 `.gitignore`에 등록되어 안전하게 보호됩니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase 프로젝트 접속 주소 (URL)
# ------------------------------------------------------------------------------
# - 설명: Supabase에서 생성한 프로젝트의 고유 API 서버 주소입니다.
# - 확인 위치: Supabase 대시보드 -> Project Settings -> Configuration -> API -> Project URL
# - 예시: https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# ------------------------------------------------------------------------------
# 2. Supabase 공개 익명 키 (Anon Public Key)
# ------------------------------------------------------------------------------
# - 설명: 프론트엔드(브라우저) 및 일반 사용자 조회 요청 시 사용하는 공개 키입니다.
# - RLS(Row Level Security, 행 단위 보안 정책)에 의해 권한이 제어되므로 브라우저에 노출되어도 안전합니다.
# - 확인 위치: Supabase 대시보드 -> Project Settings -> Configuration -> API -> Project API Keys -> anon public
# - 예시: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# 3. (선택 사항) Supabase 서버 전용 마스터 비밀 키 (Service Role Key)
# ------------------------------------------------------------------------------
# - 설명: 백엔드 관리자용 키입니다. 모든 RLS 보안 정책을 우회할 수 있는 강력한 권한을 가집니다.
# - 주의: 이 키는 절대로 'NEXT_PUBLIC_' 접두사를 붙이거나 브라우저 코드에서 사용해서는 안 됩니다!
# - 확인 위치: Supabase 대시보드 -> Project Settings -> Configuration -> API -> Project API Keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
