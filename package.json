{
  "name": "u-live",
  "version": "1.0.0",
  "private": true,
  "description": "울산과학대학교 앵커사업단 평생직업교육 포털 및 LMS 플랫폼",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run manuals:check",
    "prebuild:vercel": "npm run manuals:check",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "manuals:build": "node scripts/build-manuals.mjs --draft",
    "manuals:release": "node scripts/build-manuals.mjs --release",
    "manuals:check": "node scripts/build-manuals.mjs --check",
    "test:manuals": "node scripts/verify-manuals.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "test:core": "node scripts/verify-core.mjs",
    "check:db-performance": "node scripts/check-db-performance.mjs",
    "test:db-performance": "node scripts/verify-db-performance.mjs",
    "test:db-response": "node scripts/verify-db-response-optimization.mjs",
    "test:db-latency": "node scripts/verify-db-latency-followup.mjs",
    "test:operation-list:local": "node scripts/verify-operation-list-optimization.mjs",
    "test:db-response:local": "node scripts/verify-db-response-local.mjs",
    "test:workspace-queries": "node scripts/verify-workspace-queries.mjs",
    "test:operation-prefill": "node scripts/verify-prefilled-operation-documents.mjs",
    "test:auth-load": "node scripts/check-auth-load.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "check:release": "node -- scripts/check-release-readiness.mjs",
    "test:release": "node scripts/verify-release-readiness.mjs",
    "check:hosted-auth": "node -- scripts/check-hosted-auth.mjs",
    "test:hosted-auth": "node scripts/verify-hosted-auth.mjs",
    "test:migration-retry": "node scripts/verify-migration-retry.mjs",
    "check:self-hosted": "node -- scripts/check-self-hosted.mjs",
    "test:self-hosted": "node scripts/verify-self-hosted.mjs",
    "test:auth-candidate": "node scripts/verify-auth-candidate.mjs",
    "test:review-preview": "node scripts/verify-review-preview.mjs",
    "test:managed-cloud": "node scripts/verify-managed-cloud.mjs",
    "test:application-flow": "node scripts/verify-application-flow.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "^0.439.0",
    "next": "15.5.25",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.10",
    "tailwind-merge": "^2.5.2",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "playwright": "1.62.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "@typescript-eslint/typescript-estree@^7.0.0": {
      "minimatch": "9.0.9"
    }
  }
}
