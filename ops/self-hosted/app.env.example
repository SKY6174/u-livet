# Vercel 앱 환경 전용. 실제 값/비밀은 저장소에 쓰지 않습니다.
# Cloud용 RELEASE_PRODUCTION_SUPABASE_REF는 등록하지 않습니다.
SUPABASE_DEPLOYMENT_KIND=self-hosted
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_RATE_LIMIT_SECRET=
AUTH_SITE_ORIGIN=
CERTIFICATE_VERIFY_ORIGIN=
AUTH_CAPTCHA_ENABLED=true
AUTH_TURNSTILE_SITE_KEY=
AUTH_TRUSTED_IP_HEADER=x-vercel-forwarded-for

# 서버 전용 배포 식별 정보. 실제 값은 운영자가 증거와 대조합니다.
SELF_HOSTED_STACK_ID=
SELF_HOSTED_AUTH_IMAGE=
# check:self-hosted의 비밀 없는 설정 지문. 실제 인증 인수와는 다릅니다.
SELF_HOSTED_CONFIG_DIGEST=

# 두 Vercel 환경에 같은 운영 기준을 등록. Preview는 모두 달라야 합니다.
RELEASE_PRODUCTION_SITE_ORIGIN=
RELEASE_PRODUCTION_BACKEND_ORIGIN=
RELEASE_PRODUCTION_STACK_ID=
# VERCEL / VERCEL_ENV는 플랫폼 시스템 변수입니다.
# Auth 서버의 DB/JWT/SMTP/CAPTCHA 비밀은 이 앱 환경에 넣지 않습니다.
